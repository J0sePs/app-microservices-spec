            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceWalletId\": \"{{wallet_id}}\",\n  \"targetWalletId\": \"{{target_wallet_id}}\",\n  \"amount\": 100,\n  \"currency\": \"PEN\",\n  \"externalReference\": \"TRX-POSTMAN-{{$timestamp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{wallet_base_url}}/v1/transfers",
            "description": "Mueve soles entre dos billeteras en una sola transaccion. `target_wallet_id` debe existir en la billetera que estes usando."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Transferencia o replay', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 422]);",
                  "});",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.transferId) { pm.collectionVariables.set('transfer_id', body.transferId); }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Reversar movimiento",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Idempotency-Key", "value": "{{$guid}}", "type": "text" },
              { "key": "X-Correlation-Id", "value": "{{$guid}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"error de caja (prueba Postman)\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{wallet_base_url}}/v1/movements/{{movement_id}}/reverse",
            "description": "Crea el asiento compensatorio por el total. `movement_id` sale de 'Cobrar', 'Recargar' o 'Movimientos'."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reversa o replay', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 422]);",
                  "});",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    if (body.movements && body.movements.length > 0) {",
                  "        pm.collectionVariables.set('reversal_movement_id', body.movements[0].id);",
                  "    }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Flujo integrado (ambos servicios)",
      "description": "Cadena completa: billetera -> recarga -> retiro -> movimientos -> reversa -> saldo. Asegurate de que withdrawal-soles apunte a la misma billetera que wallet_base_url.",
      "item": [
        {
          "name": "1. Obtener billetera (wallet_id)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Correlation-Id", "value": "{{$guid}}", "type": "text" }
            ],
            "url": {
              "raw": "{{wallet_base_url}}/v1/wallets?idUsuario={{wallet_user_id}}",
              "host": ["{{wallet_base_url}}"],
              "path": ["v1", "wallets"],
              "query": [
                { "key": "idUsuario", "value": "{{wallet_user_id}}" }
              ]
            },
            "description": "Paso 1. Si responde 404, ejecuta 'Abrir billetera' en la carpeta 2."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Billetera encontrada', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('wallet_id', body.id);",
                  "    pm.collectionVariables.set('wallet_balance_cents', String(body.balance));",
                  "    console.log('Saldo inicial: ' + body.balance + ' centimos');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Recargar S/ 25.00 (2500 centimos)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "Idempotency-Key", "value": "{{$guid}}", "type": "text" },
              { "key": "X-Correlation-Id", "value": "{{$guid}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {{top_up_cents}},\n  \"currency\": \"PEN\",\n  \"externalReference\": \"DEP-POSTMAN-{{$timestamp}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{wallet_base_url}}/v1/wallets/{{wallet_id}}/top-ups",
            "description": "Paso 2. Deja saldo suficiente para el retiro de S/ 10.00."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Recarga aceptada', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Consultar billetera (saldo antes)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Correlation-Id", "value": "{{$guid}}", "type": "text" }
            ],
            "url": "{{wallet_base_url}}/v1/wallets?idUsuario={{wallet_user_id}}",
            "description": "Paso 3. Consulta por idUsuario (soportado por la API publicada y por el stub local) y guarda el saldo previo en wallet_balance_before."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Billetera disponible', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('wallet_balance_before', String(body.balance));",
                  "    console.log('Saldo antes del retiro: ' + body.balance + ' centimos');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Crear retiro S/ 10.00 (mi servicio)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "X-User-Id", "value": "{{user_id}}", "type": "text" },
              { "key": "Idempotency-Key", "value": "{{$guid}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account_id\": \"{{account_id}}\",\n  \"amount\": \"{{withdrawal_amount}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{withdrawal_base_url}}/api/v1/withdrawals",
            "description": "Paso 4. El servicio valida la cuenta, debita la billetera y reporta al ledger. Guarda withdrawal_id y los ids de la billetera."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retiro creado', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('withdrawal_id', body.id);",
                  "    if (body.wallet_movement_id) {",
                  "        pm.collectionVariables.set('withdrawal_movement_id', body.wallet_movement_id);",
                  "    }",
                  "    console.log('withdrawal_id=' + body.id + ', status=' + body.status);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Consultar retiro",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-User-Id", "value": "{{user_id}}", "type": "text" }
            ],
            "url": "{{withdrawal_base_url}}/api/v1/withdrawals/{{withdrawal_id}}",
            "description": "Paso 5. Confirma el estado (COMPLETED si el ledger respondio) y los ids de la billetera."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Retiro disponible', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    console.log('status=' + body.status + ', wallet_movement_id=' + body.wallet_movement_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Movimientos de la billetera",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Correlation-Id", "value": "{{$guid}}", "type": "text" }
            ],
            "url": {
              "raw": "{{wallet_base_url}}/v1/wallets/{{wallet_id}}/movements?limit=10",
              "host": ["{{wallet_base_url}}"],
              "path": ["v1", "wallets", "{{wallet_id}}", "movements"],
              "query": [
                { "key": "limit", "value": "10" }
              ]
            },
            "description": "Paso 6. Debe aparecer el PAYMENT con externalReference igual al withdrawal_id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Historial devuelto', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    const withdrawalId = pm.collectionVariables.get('withdrawal_id');",
                  "    const match = (body.items || []).find(function (m) {",
                  "        return m.externalReference === withdrawalId;",
                  "    });",
                  "    pm.test('El cobro del retiro esta en el historial', function () {",
                  "        pm.expect(match, 'movimiento con externalReference=' + withdrawalId).to.not.be.undefined;",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Reversar retiro (mi servicio)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" },
              { "key": "X-User-Id", "value": "{{user_id}}", "type": "text" },
              { "key": "Idempotency-Key", "value": "{{$guid}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Reversa del flujo integrado Postman\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{withdrawal_base_url}}/api/v1/withdrawals/{{withdrawal_id}}/reverse",
            "description": "Paso 7. Devuelve el monto completo a la billetera."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Reversa aceptada', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 422]);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    pm.collectionVariables.set('reversal_movement_id', body.wallet_reversal_movement_id || '');",
                  "    console.log('status=' + body.status + ', reversal=' + body.wallet_reversal_movement_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "8. Consultar saldo restaurado",
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Correlation-Id", "value": "{{$guid}}", "type": "text" }
            ],
            "url": "{{wallet_base_url}}/v1/wallets?idUsuario={{wallet_user_id}}",
            "description": "Paso 8. El saldo debe volver al valor guardado en wallet_balance_before."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Billetera disponible', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    const before = pm.collectionVariables.get('wallet_balance_before');",
                  "    console.log('Saldo final: ' + body.balance + ' centimos (antes: ' + before + ')');",
                  "    pm.test('Saldo restaurado tras la reversa', function () {",
                  "        pm.expect(String(body.balance)).to.equal(String(before));",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
