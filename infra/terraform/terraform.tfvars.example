# Copy to terraform.tfvars (ignored by git) and adjust the values.
aws_region     = "us-east-1"
project_name   = "app-nube-2"
environment    = "dev"
vpc_cidr       = "10.20.0.0/16"
kubernetes_version = "1.35"

node_instance_types = ["t3.small"]
node_min_size       = 1
node_desired_size   = 2
node_max_size       = 2

db_instance_class = "db.t4g.micro"
db_allocated_storage = 20
db_name     = "withdrawal_soles_db"
db_username = "withdrawal"

# ECR keeps the newest N images; untagged images expire after one day.
ecr_max_image_count = 15

# Extra cluster admins, e.g. the IAM user behind the GitHub Actions secrets.
# Leave empty when CI uses the same IAM identity that created the cluster.
# cluster_admin_principal_arns = ["arn:aws:iam::<account-id>:user/github-actions-withdrawal-soles"]

# Free Tier accounts must keep this at 0.
db_backup_retention_period = 0

# Do not commit a real password. Prefer TF_VAR_db_password or an ignored
# terraform.tfvars file.
# db_password = "replace-with-a-strong-password"
